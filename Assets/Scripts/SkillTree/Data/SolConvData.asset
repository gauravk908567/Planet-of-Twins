  abilityName: Soul Convergence
  abilityDescription: "\"Each enemy defeated feeds a hidden reservoir. When it fills
    \u2014 twenty\nkills \u2014 the twins feel it. Hold F to release the convergence.
    For seven\nseconds the twins deal 35% more damage and absorb 35% less. The counter\nresets
    when the power fires, not before.\""
  baseTargetCount: 1
  baseDuration: 3
  baseCooldown: 7
  baseRange: 5
  baseRegenRate: 16.6
